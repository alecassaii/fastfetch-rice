{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 10
    },
    "size": {
      "binaryPrefix": "jedec"
    },
    "separator": ""
  },
  "logo": {
        "type": "small",
        "height": 10,
        "width": 30,
        "padding": {
            "top": 3,
            "left": 3,
            "bottom": 1
        }
    },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "os",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "ker",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "sh",
      "keyColor": "red",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "de",
      "key": "de",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "up",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "keyColor": "magenta",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "gpu",
      "keyColor": "magenta",
      "format": "{name}",
      "maxCount": 1,
      "gpuIndex": 0,
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "ram",
      "keyColor": "cyan",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "disk",
      "keyColor": "cyan",
      "folders": [
        "/"
      ],
      "format": "{size-used} / {size-total}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[33m󰮯 \u001b[32m󰊠 \u001b[34m󰊠 \u001b[31m󰊠 \u001b[36m󰊠 \u001b[35m󰊠 \u001b[37m󰊠"
    }
  ]
}
